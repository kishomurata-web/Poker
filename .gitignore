# test_offline.js drives a real browser, so running the tests installs
# playwright here. The collector's batch files install it the same way on the
# PC. It is a dependency of the tests, not part of the app the phone stores.
node_modules/
package.json
package-lock.json

# What the converter writes for the app to serve. Several gigabytes, rebuilt
# from the collector's cache by convert.bat.
postflop/

# Bytecode for strategy/, written whenever build.py runs.
__pycache__/
*.pyc

# What export_freqs.py and export_hands.py read out of the collector's cache,
# and what build.py then reads. Tens of megabytes per stack depth, and the
# cache on the PC is the real source - these are rebuilt from it, not edited.
flop*.csv.gz
turn*.csv.gz
hands*.csv.gz
turnhands*.csv.gz
